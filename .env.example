# ==============================================================================
# DoubtHub — Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (from Supabase Dashboard > Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Optional) Restrict registration to college email domain (e.g., "jit.edu.in" or "college.edu")
# Leave empty to allow any valid email signup
VITE_ALLOWED_EMAIL_DOMAIN=

# (Optional) AI Assistance Configuration
# Set to "gemini" | "openai" when using custom edge functions
VITE_AI_PROVIDER=gemini
